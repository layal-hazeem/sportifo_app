<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:thickness="8dp" android:useLevel="false">
            <solid android:color="@color/progress_background" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270">
            <shape android:shape="ring" android:thickness="8dp" android:useLevel="true">
                <gradient android:startColor="@color/calorie_start" android:endColor="@color/calorie_end" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>